{
    "name": "itech-world/sulu-content-ai-bundle",
    "description": "AI-powered content assistant for Sulu CMS 3.x: fill page/article blocks from an in-admin chat and create drafts, powered by symfony/ai (multi-provider: OpenAI, Mistral, Anthropic)",
    "type": "sulu-bundle",
    "license": "MIT",
    "keywords": ["sulu", "symfony", "cms", "php", "ai", "llm", "openai", "anthropic", "mistral", "content-generation"],
    "authors": [
        {
            "name": "Steeven THOMAS",
            "homepage": "https://github.com/steeven-th"
        }
    ],
    "require": {
        "php": "^8.2",
        "sulu/sulu": "^3.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/console": "^7.0",
        "doctrine/orm": "^3.0",
        "doctrine/doctrine-bundle": "^2.11",
        "symfony/ai-platform": "~0.10.0",
        "symfony/ai-open-ai-platform": "~0.10.0",
        "symfony/ai-anthropic-platform": "~0.10.0",
        "symfony/ai-mistral-platform": "~0.10.0",
        "symfony/ai-agent": "~0.10.0",
        "symfony/ai-bundle": "~0.10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/debug-bundle": "^7.0"
    },
    "suggest": {
        "sulu/article-bundle": "Enables the AI assistant and draft creation on articles (^3.0)"
    },
    "autoload": {
        "psr-4": {
            "ItechWorld\\SuluContentAiBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItechWorld\\SuluContentAiBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true
        }
    }
}
