<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>iw_ai_providers</key>

    <properties>
        <property name="id" visibility="no" searchability="no" translation="sulu_admin.id">
            <field-name>id</field-name>
            <entity-name>ItechWorld\SuluContentAiBundle\Entity\AiProviderConfig</entity-name>
        </property>

        <property name="provider" visibility="always" searchability="yes" translation="iw_sulu_content_ai.provider">
            <field-name>provider</field-name>
            <entity-name>ItechWorld\SuluContentAiBundle\Entity\AiProviderConfig</entity-name>
        </property>

        <property name="model" visibility="yes" translation="iw_sulu_content_ai.model_label">
            <field-name>model</field-name>
            <entity-name>ItechWorld\SuluContentAiBundle\Entity\AiProviderConfig</entity-name>
        </property>

        <property name="enabled" visibility="yes" translation="iw_sulu_content_ai.enabled">
            <field-name>enabled</field-name>
            <entity-name>ItechWorld\SuluContentAiBundle\Entity\AiProviderConfig</entity-name>
            <transformer type="bool"/>
        </property>

        <property name="changed" visibility="yes" translation="sulu_admin.changed">
            <field-name>changed</field-name>
            <entity-name>ItechWorld\SuluContentAiBundle\Entity\AiProviderConfig</entity-name>
            <transformer type="datetime"/>
        </property>
    </properties>
</list>
