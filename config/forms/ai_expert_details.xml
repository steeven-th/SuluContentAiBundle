<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd">

    <key>iw_ai_expert_details</key>

    <properties>
        <property name="name" type="text_line" mandatory="true">
            <meta>
                <title>sulu_admin.name</title>
            </meta>
            <params>
                <param name="headline" value="true"/>
                <param name="autofocus" value="true"/>
            </params>
        </property>

        <property name="systemPrompt" type="text_area" mandatory="true">
            <meta>
                <title>iw_sulu_content_ai.system_prompt</title>
                <info_text>iw_sulu_content_ai.system_prompt_info</info_text>
            </meta>
        </property>

        <property name="description" type="text_area">
            <meta>
                <title>iw_sulu_content_ai.description</title>
            </meta>
        </property>

        <property name="enabled" type="checkbox">
            <meta>
                <title>iw_sulu_content_ai.enabled</title>
            </meta>
            <params>
                <param name="default_value" value="true"/>
            </params>
        </property>
    </properties>
</form>
